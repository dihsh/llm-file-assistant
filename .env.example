# LLM File Assistant - Environment Configuration

# Option 1: OpenAI API Key (e.g. gpt-4o, gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Google Gemini API Key (Gemini 2.5 Flash / 1.5 Flash)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom OpenAI compatible endpoint (Ollama, vLLM, Groq, OpenRouter)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1
