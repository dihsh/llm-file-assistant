# LLM File Assistant - Environment Configuration

# Primary: Google Gemini Free API Key (Get free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_free_gemini_api_key_here
OPENAI_MODEL=gemini-2.5-flash

# Secondary / Optional: OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here

# Secondary / Optional: Custom OpenAI compatible endpoint (Ollama, vLLM, Groq)
# OPENAI_BASE_URL=http://localhost:11434/v1
